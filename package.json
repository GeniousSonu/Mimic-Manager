{
  "name": "mimic-manager-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified open-source site optimization platform",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contrast": "pnpm --filter @mimic-manager/ui check-contrast",
    "test:php": "cd connectors/wordpress && vendor/bin/phpunit",
    "brand:apply": "node scripts/brand/apply.ts",
    "brand:check": "node scripts/brand/check.ts",
    "brand:rename": "node scripts/brand/rename.ts",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "sharp": "^0.35.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "mongodb": "^7.7.0",
    "redis": "^6.3.0"
  }
}
