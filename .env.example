STORAGE_PATH=/tmp/mimic-manager/storage
MAX_IMAGE_PIXELS=50000000
MAX_UPLOAD_BYTES=52428800

# Rate Limiting & Fallbacks
RATE_LIMIT_MAX=120
OLLAMA_BASE_URL=http://localhost:11434
