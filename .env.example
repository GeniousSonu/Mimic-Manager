# Mimic Manager Environment Configuration
# Free zero-credit-card deployment targets:
# - API + In-Process Worker: Render (Free Web Service)
# - Command Center PWA: Vercel
# - Database: MongoDB Atlas (Free M0)
# - Cache / Queues: Redis from redis.io
# - Vision & SEO AI: Google AI Studio via OpenAI-compatible endpoint
# - Storage: Local disk storage

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
RUN_MODE=continue-all

# Cryptographic Keys (Auto-generated or specified in hex)
JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8
MASTER_KMS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Render Free Tier Worker Mode
IN_PROCESS_WORKER=true
RUN_IN_PROCESS_WORKER=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://wefikplugin_db_user:PS7dOJI1EYpXxqLt@mimic-manager.4llnuji.mongodb.net/mimic_manager?retryWrites=true&w=majority

# Cloud Redis (redis.io)
REDIS_URI=redis://default:huUHbKPYM59eSIZ45Rr4N2xXIxXJKGWX@jump-textural-constructive-72143.db.redis.io:19041
REDIS_URL=redis://default:huUHbKPYM59eSIZ45Rr4N2xXIxXJKGWX@jump-textural-constructive-72143.db.redis.io:19041
REDIS_HOST=jump-textural-constructive-72143.db.redis.io
REDIS_PORT=19041
REDIS_USERNAME=default
REDIS_PASSWORD=huUHbKPYM59eSIZ45Rr4N2xXIxXJKGWX

# Google AI Studio (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your_google_ai_studio_api_key_here
