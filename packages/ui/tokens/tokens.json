{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Mimic Manager Design Tokens",
  "version": "1.0.0",
  "color": {
    "dark": {
      "bg": {
        "canvas": "#0A0805",
        "surface": "#120E09",
        "raised": "#1A140D",
        "overlay": "#221B12",
        "inset": "#0D0906"
      },
      "border": {
        "subtle": "#261C12",
        "default": "#3A2A1A",
        "strong": "#96744C"
      },
      "text": {
        "primary": "#FFF8EE",
        "secondary": "#D4C4B0",
        "tertiary": "#948270",
        "disabled": "#5E5042",
        "inverse": "#0A0805"
      },
      "accent": {
        "default": "#FFB000",
        "hover": "#FFC229",
        "pressed": "#E69500",
        "subtle": "rgba(255, 176, 0, 0.12)",
        "onAccent": "#1A0F00"
      },
      "semantic": {
        "success": "#28C76F",
        "warning": "#FF9A00",
        "danger": "#F2555A",
        "info": "#FFB000"
      },
      "tier": {
        "safe": "#28C76F",
        "moderate": "#FF9A00",
        "guided": "#FFB000"
      }
    },
    "light": {
      "bg": {
        "canvas": "#FBF9F5",
        "surface": "#FFFFFF",
        "raised": "#F4EFE6",
        "overlay": "#FFFFFF",
        "inset": "#EAE3D6"
      },
      "border": {
        "subtle": "#E5DCCE",
        "default": "#C7B9A3",
        "strong": "#695843"
      },
      "text": {
        "primary": "#1A1208",
        "secondary": "#473824",
        "tertiary": "#7A6852",
        "disabled": "#A89A86",
        "inverse": "#FFFFFF"
      },
      "accent": {
        "default": "#D97706",
        "hover": "#B45309",
        "pressed": "#92400E",
        "subtle": "rgba(217, 119, 6, 0.12)",
        "onAccent": "#FFFFFF"
      },
      "semantic": {
        "success": "#146C36",
        "warning": "#945600",
        "danger": "#B91C1C",
        "info": "#8C3B00"
      },
      "tier": {
        "safe": "#146C36",
        "moderate": "#945600",
        "guided": "#8C3B00"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'SF Pro', 'San Francisco', system-ui, sans-serif",
      "mono": "'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "18px",
      "base": "20px",
      "md": "24px",
      "lg": "26px",
      "xl": "28px",
      "2xl": "32px",
      "3xl": "38px",
      "4xl": "44px",
      "5xl": "56px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "0": "0px",
    "1": "2px",
    "2": "4px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "20px",
    "7": "24px",
    "8": "32px",
    "9": "40px",
    "10": "48px",
    "12": "64px",
    "16": "80px",
    "20": "96px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "base": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "140ms",
      "normal": "220ms",
      "slow": "320ms",
      "deliberate": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.05)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
