{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Mimic Manager Design Tokens",
  "version": "1.0.0",
  "color": {
    "dark": {
      "bg": {
        "canvas": "#0A0C10",
        "surface": "#10131A",
        "raised": "#161A23",
        "overlay": "#1C212C",
        "inset": "#0D1016"
      },
      "border": {
        "subtle": "#1F2430",
        "default": "#2A3040",
        "strong": "#626D85"
      },
      "text": {
        "primary": "#E9ECF3",
        "secondary": "#A5AEC0",
        "tertiary": "#747E92",
        "disabled": "#4B5365",
        "inverse": "#0A0C10"
      },
      "accent": {
        "default": "#7C6CFF",
        "hover": "#8F81FF",
        "pressed": "#6A59F0",
        "subtle": "rgba(124, 108, 255, 0.12)",
        "onAccent": "#FFFFFF"
      },
      "semantic": {
        "success": "#2FBF8F",
        "warning": "#F5A524",
        "danger": "#F2555A",
        "info": "#4DA3FF"
      },
      "tier": {
        "safe": "#2FBF8F",
        "moderate": "#F5A524",
        "guided": "#4DA3FF"
      }
    },
    "light": {
      "bg": {
        "canvas": "#F7F8FA",
        "surface": "#FFFFFF",
        "raised": "#F0F2F5",
        "overlay": "#FFFFFF",
        "inset": "#ECEFF3"
      },
      "border": {
        "subtle": "#D1D5DF",
        "default": "#B0B7C6",
        "strong": "#697285"
      },
      "text": {
        "primary": "#12151C",
        "secondary": "#3E4554",
        "tertiary": "#555D6E",
        "disabled": "#8D95A5",
        "inverse": "#FFFFFF"
      },
      "accent": {
        "default": "#533FFF",
        "hover": "#432FF0",
        "pressed": "#3320E0",
        "subtle": "rgba(83, 63, 255, 0.10)",
        "onAccent": "#FFFFFF"
      },
      "semantic": {
        "success": "#0E6E4C",
        "warning": "#945600",
        "danger": "#B81D24",
        "info": "#0D59B0"
      },
      "tier": {
        "safe": "#0E6E4C",
        "moderate": "#945600",
        "guided": "#0D59B0"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "18px",
      "base": "20px",
      "md": "24px",
      "lg": "26px",
      "xl": "28px",
      "2xl": "32px",
      "3xl": "38px",
      "4xl": "44px",
      "5xl": "56px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "0": "0px",
    "1": "2px",
    "2": "4px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "20px",
    "7": "24px",
    "8": "32px",
    "9": "40px",
    "10": "48px",
    "12": "64px",
    "16": "80px",
    "20": "96px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "base": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "140ms",
      "normal": "220ms",
      "slow": "320ms",
      "deliberate": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.05)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
