{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Mimic Manager Design Tokens",
  "version": "1.0.0",
  "color": {
    "dark": {
      "bg": {
        "canvas": "#0A0A0B",
        "surface": "#161618",
        "raised": "#1F1F23",
        "overlay": "#28282E",
        "inset": "#111113"
      },
      "border": {
        "subtle": "#27272B",
        "default": "#3B3B42",
        "strong": "#8E8E9A"
      },
      "text": {
        "primary": "#F4F4F6",
        "secondary": "#A1A1AA",
        "tertiary": "#71717A",
        "disabled": "#52525B",
        "inverse": "#0A0A0B"
      },
      "accent": {
        "default": "#00E5FF",
        "hover": "#33ECFF",
        "pressed": "#00B8CC",
        "subtle": "rgba(0, 229, 255, 0.12)",
        "onAccent": "#0A0A0B",
        "violet": "#7B61FF",
        "onViolet": "#FFFFFF"
      },
      "semantic": {
        "success": "#28C76F",
        "warning": "#FF9A00",
        "danger": "#F2555A",
        "info": "#00E5FF"
      },
      "tier": {
        "safe": "#28C76F",
        "moderate": "#FF9A00",
        "guided": "#7B61FF"
      }
    },
    "light": {
      "bg": {
        "canvas": "#F8F9FA",
        "surface": "#FFFFFF",
        "raised": "#F1F3F5",
        "overlay": "#FFFFFF",
        "inset": "#E9ECEF"
      },
      "border": {
        "subtle": "#E2E8F0",
        "default": "#CBD5E1",
        "strong": "#505A69"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "tertiary": "#64748B",
        "disabled": "#94A3B8",
        "inverse": "#FFFFFF"
      },
      "accent": {
        "default": "#0284C7",
        "hover": "#0369A1",
        "pressed": "#075985",
        "subtle": "rgba(2, 132, 199, 0.12)",
        "onAccent": "#FFFFFF",
        "violet": "#6D28D9",
        "onViolet": "#FFFFFF"
      },
      "semantic": {
        "success": "#146C36",
        "warning": "#8C4B00",
        "danger": "#B91C1C",
        "info": "#0369A1"
      },
      "tier": {
        "safe": "#146C36",
        "moderate": "#8C4B00",
        "guided": "#6D28D9"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Consolas, Menlo, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px",
      "5xl": "48px"
    },
    "lineHeight": {
      "xs": "16px",
      "sm": "18px",
      "base": "20px",
      "md": "24px",
      "lg": "26px",
      "xl": "28px",
      "2xl": "32px",
      "3xl": "38px",
      "4xl": "44px",
      "5xl": "56px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "0": "0px",
    "1": "2px",
    "2": "4px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "20px",
    "7": "24px",
    "8": "32px",
    "9": "40px",
    "10": "48px",
    "12": "64px",
    "16": "80px",
    "20": "96px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "base": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "motion": {
    "duration": {
      "instant": "90ms",
      "fast": "140ms",
      "normal": "220ms",
      "slow": "320ms",
      "deliberate": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.05)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
