{
  "name": "wefik/mimic-manager",
  "description": "Free and Secure platform for image optimization, PageSpeed and SEO fixes, UI section replication, and visual file management, with a WordPress connector and a PWA command center.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "SK Sahinur Islam",
      "homepage": "https://www.genioussonu.me",
      "role": "Creator and Lead Author"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.7",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Wefik\\MimicManager\\": "src/",
      "Wefik\\MimicManager\\Includes\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wefik\\MimicManager\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "homepage": "https://www.wefik.in",
  "version": "1.0.0-rc.1"
}
