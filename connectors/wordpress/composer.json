{
  "name": "mimic-manager/connector",
  "description": "WordPress connector plugin for OptiForge / Mimic Manager",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "OptiForge Team"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "MimicManager\\": "src/",
      "OptiForge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MimicManager\\Tests\\": "tests/",
      "OptiForge\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
